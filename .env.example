#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE - Configuration flexible pour chaque développeur
#--------------------------------------------------------------------

# Configuration de base (fonctionne pour MySQL standard)
database.default.hostname = localhost
database.default.database = nutri_goal
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBDebug = true

# ⚠️ IMPORTANT - Décommenter UNE des options ci-dessous selon votre setup:

# 🔧 Option 1: Si vous utilisez XAMPP (Linux/Mac):
# Décommentez la ligne ci-dessous et remplacez le chemin si nécessaire
# database.default.socket = /opt/lampp/var/mysql/mysql.sock

# 🔧 Option 2: Si vous utilisez XAMPP (Windows):
# database.default.socket = C:\xampp\mysql\mysql.sock

# 🔧 Option 3: Si vous utilisez MySQL standard (Linux):
# database.default.socket = /var/run/mysqld/mysqld.sock

# 🔧 Option 4: Si vous utilisez Docker MySQL:
# database.default.hostname = mysql
# database.default.port = 3306

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = writable/session

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4
